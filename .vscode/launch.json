  "version": "0.2.0",
  "configurations": [

    {
      "name": "q_master",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "preLaunchTask": "Pre-Launch Check",
      "toolArgs": ["--dart-define=DEBUG=true"]
    },
    {
      "name": "q_master (no checks)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "q_master (profile mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "q_master (release mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ],
  "compounds": [
    {
      "name": "Full Dev (Analyze + Launch)",
      "configurations": ["q_master"],
      "stopAll": true
    }
  ]
}
