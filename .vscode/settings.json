{
  // Dart/Flutter
  "dart.flutterHotReloadOnSave": "all",
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "dart.openDevTools": "never",
  // Editor
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  // Files
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.dart": "${capture}.freezed.dart, ${capture}.g.dart",
    "pubspec.yaml": "pubspec.lock, .flutter-plugins, .flutter-plugins-dependencies, .packages, .dart_tool"
  },
  // Debug
  "debug.openDebug": "openOnDebugBreak",
  // Dart-specific editor
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.rulers": [
      80
    ],
    "editor.tabSize": 2,
    "editor.selectionHighlight": false,
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "always"
    }
  },
  "chat.tools.terminal.autoApprove": {
    "open": true,
    "/^mkdir -p lib/services\npython3 - <<'PY'\nfrom pathlib import Path\n\nex_path = Path\\('lib/model/exicon_fetcher\\.dart'\\)\nex = ex_path\\.read_text\\(\\)\nmodels = ex\\[ex\\.index\\('@freezed\\\\n'\\):ex\\.index\\('/// Provides a list of Exicon entries'\\)\\]\nhelpers = ex\\[ex\\.index\\('/// Reads a non-empty string'\\):ex\\.index\\('List<Map<String, Object\\?>> _extractRows'\\)\\]\nPath\\('lib/model/exicon\\.dart'\\)\\.write_text\\(\"import 'dart:developer' as developer;\\\\n\\\\nimport 'package:freezed_annotation/freezed_annotation\\.dart';\\\\n\\\\npart 'exicon\\.freezed\\.dart';\\\\npart 'exicon\\.g\\.dart';\\\\n\\\\n\" \\+ models \\+ helpers\\)\nfetch = ex\\[:ex\\.index\\('@freezed\\\\n'\\)\\] \\+ ex\\[ex\\.index\\('/// Provides a list of Exicon entries'\\):ex\\.index\\('/// Reads a non-empty string'\\)\\] \\+ ex\\[ex\\.index\\('List<Map<String, Object\\?>> _extractRows'\\):\\]\nfetch = fetch\\.replace\\(\"import 'package:freezed_annotation/freezed_annotation\\.dart';\\\\n\", ''\\)\\.replace\\(\"part 'exicon_fetcher\\.freezed\\.dart';\\\\n\", ''\\)\\.replace\\(\"part 'exicon_fetcher\\.g\\.dart';\", \"import '\\.\\./model/exicon\\.dart';\\\\n\\\\npart 'exicon_fetcher\\.g\\.dart';\"\\)\nPath\\('lib/services/exicon_fetcher\\.dart'\\)\\.write_text\\(fetch\\)\nex_path\\.unlink\\(\\)\n\nf3_path = Path\\('lib/model/f3_nation_fetcher\\.dart'\\)\nf3 = f3_path\\.read_text\\(\\)\nmodels = f3\\[f3\\.index\\('/// A region, area, or AO'\\):f3\\.index\\('/// Client for the F3 Nation API'\\)\\]\nhelpers = f3\\[f3\\.index\\('int\\? _readInt\\('\\):\\]\nPath\\('lib/model/f3_nation\\.dart'\\)\\.write_text\\(\"import 'package:freezed_annotation/freezed_annotation\\.dart';\\\\n\\\\npart 'f3_nation\\.freezed\\.dart';\\\\n\\\\n\" \\+ models \\+ helpers\\)\nclient = f3\\[:f3\\.index\\('/// A region, area, or AO'\\)\\] \\+ f3\\[f3\\.index\\('/// Client for the F3 Nation API'\\):f3\\.index\\('int\\? _readInt\\('\\)\\]\nclient = client\\.replace\\(\"import 'package:freezed_annotation/freezed_annotation\\.dart';\\\\n\", ''\\)\\.replace\\(\"part 'f3_nation_fetcher\\.freezed\\.dart';\\\\npart 'f3_nation_fetcher\\.g\\.dart';\", \"import '\\.\\./model/f3_nation\\.dart';\\\\n\\\\npart 'f3_nation_client\\.g\\.dart';\"\\)\nclient = client\\.replace\\('F3NationFetcher', 'F3NationClient'\\)\\.replace\\('Requires an API key supplied by Firebase Remote Config before any method is\\\\n/// called\\.', 'Uses Firebase Cloud Functions to call the API with a server-side key\\.'\\)\nPath\\('lib/services/f3_nation_client\\.dart'\\)\\.write_text\\(client\\)\nf3_path\\.unlink\\(\\)\n\nPath\\('lib/timer/timer_tab\\.dart'\\)\\.rename\\('lib/timer/timer_screen\\.dart'\\)\nPath\\('lib/model/workout_list\\.dart'\\)\\.rename\\('lib/model/workout_list_controller\\.dart'\\)\nPath\\('test/model/f3_nation_fetcher_test\\.dart'\\)\\.rename\\('test/model/f3_nation_test\\.dart'\\)\nPath\\('test/model/exicon_fetcher_test\\.dart'\\)\\.rename\\('test/model/exicon_test\\.dart'\\)\nPath\\('test/model/workout_list_test\\.dart'\\)\\.rename\\('test/model/workout_list_controller_test\\.dart'\\)\nfor base in \\('lib', 'test'\\):\n    for path in Path\\(base\\)\\.rglob\\('\\*\\.dart'\\):\n        if path\\.name\\.endswith\\(\\('\\.g\\.dart', '\\.freezed\\.dart'\\)\\):\n            continue\n        text = path\\.read_text\\(\\)\n        original = text\n        text = text\\.replace\\('FormatttedOutput', 'WorkoutFormatting'\\)\\.replace\\('WorkoutList', 'WorkoutListController'\\)\\.replace\\('workoutListProvider', 'workoutListControllerProvider'\\)\\.replace\\('workout_list\\.dart', 'workout_list_controller\\.dart'\\)\\.replace\\('workout_list\\.g\\.dart', 'workout_list_controller\\.g\\.dart'\\)\\.replace\\('F3NationFetcher', 'F3NationClient'\\)\\.replace\\('f3NationFetcherProvider', 'f3NationClientProvider'\\)\\.replace\\('timer_tab\\.dart', 'timer_screen\\.dart'\\)\n        text = text\\.replace\\(\"import '\\.\\./model/f3_nation_fetcher\\.dart';\", \"import '\\.\\./model/f3_nation\\.dart';\\\\nimport '\\.\\./services/f3_nation_client\\.dart';\"\\)\n        text = text\\.replace\\(\"import 'package:q_master/model/f3_nation_fetcher\\.dart';\", \"import 'package:q_master/model/f3_nation\\.dart';\"\\)\n        if path\\.as_posix\\(\\) in \\('lib/workouts/exicon_catalog\\.dart', 'test/workouts/exicon_catalog_test\\.dart', 'test/model/exicon_test\\.dart'\\):\n            text = text\\.replace\\('model/exicon_fetcher\\.dart', 'model/exicon\\.dart'\\)\n        else:\n            text = text\\.replace\\(\"import '\\.\\./model/exicon_fetcher\\.dart';\", \"import '\\.\\./services/exicon_fetcher\\.dart';\"\\)\n        if text != original:\n            path\\.write_text\\(text\\)\nPY\n\ndart run build_runner build --delete-conflicting-outputs$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "java.gradle.buildServer.enabled": "on"
}
